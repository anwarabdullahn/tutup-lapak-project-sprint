    "definitions": {
        "dtos.CreateProductRequest": {
            "type": "object",
            "properties": {
                "category": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "price_cents": {
                    "type": "integer"
                }
            }
        },
        "dtos.CreatePurchaseRequest": {
            "type": "object",
            "required": [
                "purchasedItems",
                "senderContactDetail",
                "senderContactType",
                "senderName"
            ],
            "properties": {
                "purchasedItems": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/definitions/dtos.PurchaseItemRequest"
                    }
                },
                "senderContactDetail": {
                    "type": "string"
                },
                "senderContactType": {
                    "type": "string",
                    "enum": [
                        "email",
                        "phone"
                    ]
                },
                "senderName": {
                    "type": "string",
                    "maxLength": 55,
                    "minLength": 4
                }
            }
        },
        "dtos.EmailLoginRequest": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string",
                    "maxLength": 32,
                    "minLength": 8
                }
            }
        },
        "dtos.EmailRegisterRequest": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string",
                    "maxLength": 32,
                    "minLength": 8
                }
            }
        },
        "dtos.EmailRequest": {
            "type": "object",
            "required": [
                "email"
            ],
            "properties": {
                "email": {
                    "type": "string"
                }
            }
        },
        "dtos.GetPurchaseResponse": {
            "type": "object",
            "properties": {
                "createdAt": {
                    "type": "string"
                },
                "paymentDetails": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dtos.PaymentDetail"
                    }
                },
                "paymentProofIds": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "purchaseId": {
                    "type": "string"
                },
                "purchasedItems": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dtos.PurchaseItemResponse"
                    }
                },
                "senderInfo": {
                    "$ref": "#/definitions/dtos.SenderInfo"
                },
                "totalPrice": {
                    "type": "number"
                },
                "updatedAt": {
                    "type": "string"
                },
                "userId": {
                    "type": "string"
                }
            }
        },
        "dtos.ListPurchasesResponse": {
            "type": "object",
            "properties": {
                "limit": {
                    "type": "integer"
                },
                "page": {
                    "type": "integer"
                },
                "purchases": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dtos.GetPurchaseResponse"
                    }
                },
                "total": {
                    "type": "integer"
                }
            }
        },
        "dtos.LoginResponse": {
            "type": "object",
            "properties": {
                "token": {
                    "type": "string"
                },
                "user": {
                    "$ref": "#/definitions/dtos.UserResponse"
                }
            }
        },
        "dtos.PaymentDetail": {
            "type": "object",
            "properties": {
                "bankAccountHolder": {
                    "type": "string"
                },
                "bankAccountName": {
                    "type": "string"
                },
                "bankAccountNumber": {
                    "type": "string"
                },
                "totalPrice": {
                    "type": "number"
                }
            }
        },
        "dtos.PaymentProofRequest": {
            "type": "object",
            "required": [
                "fileIds"
            ],
            "properties": {
                "fileIds": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "dtos.PhoneLoginRequest": {
            "type": "object",
            "required": [
                "password",
                "phone"
            ],
            "properties": {
                "password": {
                    "type": "string",
                    "maxLength": 32,
                    "minLength": 8
                },
                "phone": {
                    "type": "string",
                    "maxLength": 15,
                    "minLength": 10
                }
            }
        },
        "dtos.PhoneRegisterRequest": {
            "type": "object",
            "required": [
                "password",
                "phone"
            ],
            "properties": {
                "password": {
                    "type": "string",
                    "maxLength": 32,
                    "minLength": 8
                },
                "phone": {
                    "type": "string",
                    "maxLength": 15,
                    "minLength": 10
                }
            }
        },
        "dtos.PhoneRequest": {
